{
  "name": "biosacha-backend",
  "version": "1.0.0",
  "description": "Backend académico del proyecto móvil BioSacha con JWT, caché cache-aside, corrección N+1 y worker asíncrono.",
  "main": "index-semana8-final.js",
  "scripts": {
    "start": "node index-semana8-final.js",
    "dev": "node --watch index-semana8-final.js",
    "check": "node --check index.js && node --check index-semana8.js && node --check index-semana8-final.js",
    "test": "npm run check",
    "start:semana12": "tsx index-semana12.ts"
  },
  "keywords": [
    "biosacha",
    "nodejs",
    "express",
    "jwt",
    "cache-aside",
    "eager-loading",
    "worker"
  ],
  "author": "Beivy Amarilis Rivera Vergara",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
