# Copie este archivo como .env y reemplace todos los valores.
PORT=3000

# Use claves largas, aleatorias y diferentes.
JWT_ACCESS_SECRET=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Contraseña exclusiva para los usuarios académicos de demostración.
DEMO_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_DEMO_SEGURA
